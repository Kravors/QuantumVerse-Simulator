#include <iostream>
#include <cmath>
#include <memory>
#include <array>
#include <vector>
#include "spacetime/Event4D.h"  -replace  \\spacetime/MetricTensor\.h\\, spacetime/MetricTensor.h\
#include \spacetime/MetricTensor.h\
#include physics/GeodesicIntegrator.h\ -replace \\physics/PhysicsConstants\.h\\, physics/PhysicsConstants.h\
#include \physics/PhysicsConstants.h\
using namespace quantumverse;
#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif
int main(){
 double M=1.0,rStart=30.0*M; double massKg=PHYS_C()*PHYS_C()/PHYS_G();
 auto metric=std::make_shared<SchwarzschildMetric>(massKg);
 GeodesicIntegrator integrator; integrator.setMetric(metric);
 double hs[]={1.0,0.5,0.25,0.125}; double bs[]={6.0,12.0};
 for(int bi=0;bi<2;bi++){
 double b=bs[bi]*M;
 for(int hi=0;hi<4;hi++){
 double h=hs[hi]; int steps=(int)(2000.0*0.5/h); if(steps<1000) steps=1000; if(steps>60000) steps=60000;
 Event4D start(0.0,b,0.0,-rStart,0.0);
 auto g=metric->evaluate(start);
 double ux=0,uy=1,uz=0;
 double spatial=g[1][1]*ux*ux+g[2][2]*uy*uy+g[3][3]*uz*uz+2.0*(g[1][2]*ux*uy+g[1][3]*ux*uz+g[2][3]*uy*uz);
 double ut=sqrt(-spatial/g[0][0]); std::array<double,4> v={ut,ux,uy,uz};
 auto traj=integrator.integrateSimple(start,v,steps,h);
 auto phi=[](const Event4D&e){ return std::atan2(e.y,e.x); };
 double phiTotal=0,phiPrev=phi(traj.front());
 for(size_t i=1;i<traj.size();i++){ double d=phi(traj[i])-phiPrev; while(d>M_PI)d-=2.0*M_PI; while(d<-M_PI)d+=2.0*M_PI; phiTotal+=d; phiPrev=phi(traj[i]); }
 double defl=phiTotal-2.0*std::atan(rStart/b);
 std::cout<<\[CONV] b=\<<(int)bs[bi]<<\M h=\<<h<<\ alpha=\<<defl<<std::endl;
 }
 }
 return 0;
}




